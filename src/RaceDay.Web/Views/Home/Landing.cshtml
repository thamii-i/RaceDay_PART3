@{
    ViewData["Title"] = "Welcome";
}
<section class="rd-hero">
    <div class="rd-hero-inner">
        <span class="rd-kicker">Run. Walk. Ride.</span>
        <h1 class="rd-heading">Your race day,<br />sorted.</h1>
        <p class="lead">RaceDay brings South African road running, walking and cycling events together. Organisers manage events and results in one place. Participants find their next challenge, enrol in seconds and track every finish.</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Get started</a>
            <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
        </div>
    </div>
</section>

<section class="row g-4 my-4">
    <div class="col-md-4">
        <div class="card rd-card h-100"><div class="card-body">
            <div class="feature-icon"><i class="bi bi-calendar-event-fill"></i></div>
            <h2 class="h4 rd-heading">Find your event</h2>
            <p class="text-muted mb-0">Browse upcoming runs, walks and cycle events, filter by type and see every category before you enter.</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card rd-card h-100"><div class="card-body">
            <div class="feature-icon"><i class="bi bi-ticket-perforated-fill"></i></div>
            <h2 class="h4 rd-heading">Enrol instantly</h2>
            <p class="text-muted mb-0">Pick a category and your entry is recorded straight away, with a bib number and a clear confirmation status.</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card rd-card h-100"><div class="card-body">
            <div class="feature-icon"><i class="bi bi-trophy-fill"></i></div>
            <h2 class="h4 rd-heading">Track your results</h2>
            <p class="text-muted mb-0">Organisers publish finish times and positions. Your personal race history builds up in one place.</p>
        </div></div>
    </div>
</section>
