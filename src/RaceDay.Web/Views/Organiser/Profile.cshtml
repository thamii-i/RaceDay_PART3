@model OrganiserProfileViewModel
@{
    ViewData["Title"] = "Organisation";
}
<div class="page-header">
    <h1 class="rd-heading">Organisation profile</h1>
    <p class="text-muted">Your details as shown to participants.</p>
</div>

<div class="card rd-card"><div class="card-body p-4">
    <form asp-action="Profile" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Email" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input value="@Model.Email" class="form-control" disabled />
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="OrganisationName" class="form-label"></label>
                <input asp-for="OrganisationName" class="form-control" />
                <span asp-validation-for="OrganisationName" class="text-danger small"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary mt-4">Save changes</button>
    </form>
</div></div>
