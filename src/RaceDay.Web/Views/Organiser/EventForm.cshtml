@model EventFormViewModel
@{
    var isEdit = Model.EventId.HasValue;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
    var banner = UiHelpers.MediaUrl(Model.ExistingBanner);
}
<div class="page-header">
    <h1 class="rd-heading">@ViewData["Title"]</h1>
    <p class="text-muted">Fill in the event details. You can add categories afterwards.</p>
</div>

<div class="card rd-card"><div class="card-body p-4">
    <form method="post" enctype="multipart/form-data" asp-controller="Organiser" asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.EventId" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="ExistingBanner" />
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="EventName" class="form-label"></label>
                <input asp-for="EventName" class="form-control" />
                <span asp-validation-for="EventName" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="">Choose...</option>
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Cycle">Cycle</option>
                </select>
                <span asp-validation-for="EventType" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" type="number" step="0.01" min="0.1" class="form-control" />
                <span asp-validation-for="DistanceKm" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="BannerFile" class="form-label"></label>
                @if (banner is not null)
                {
                    <div class="mb-2"><img src="@banner" class="banner-preview" alt="Current banner" /></div>
                }
                <input asp-for="BannerFile" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" />
                <div class="form-text">JPEG, PNG, WebP or GIF, up to 5 MB. Shown on the event page.</div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create event")</button>
            <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
        </div>
    </form>
</div></div>
