@model ResultsPageViewModel
@{
    ViewData["Title"] = "Results";
    var recorded = Model.Rows.Count(r => r.Result is not null);
}
<a class="back-link" asp-action="Events"><i class="bi bi-arrow-left"></i> My events</a>
<div class="page-header mt-2 d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1 class="rd-heading">Results entry</h1>
        <p class="text-muted mb-0">
            @Model.Event.EventName, @Model.Event.EventDate.ToString("dd MMM yyyy")
            @if (Model.IsPast) { <span class="status-badge status-confirmed ms-2"><i class="bi bi-flag-fill"></i> Concluded</span> }
            else { <span class="status-badge status-pending ms-2"><i class="bi bi-hourglass-split"></i> Not yet held</span> }
        </p>
    </div>
    <form asp-action="Publication" method="post" class="d-flex align-items-center gap-2">
        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
        <input type="hidden" name="publish" value="@((!Model.Event.ResultsPublished).ToString().ToLowerInvariant())" />
        @if (Model.Event.ResultsPublished)
        {
            <span class="status-badge status-confirmed"><i class="bi bi-eye-fill"></i> Published</span>
            <button type="submit" class="btn btn-outline-secondary">Unpublish results</button>
        }
        else
        {
            <span class="status-badge status-pending"><i class="bi bi-eye-slash-fill"></i> Not published</span>
            <button type="submit" class="btn btn-primary" disabled="@(recorded == 0)"><i class="bi bi-megaphone-fill"></i> Publish results</button>
        }
    </form>
</div>

<p class="text-muted">Enter each participant's finish time (hh:mm:ss) and finishing position after the event. Participants see their results only once you publish them.</p>

@if (Model.Rows.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-people"></i>
        <h2 class="h4 rd-heading">No participants to score</h2>
        <p class="text-muted">There are no active enrolments for this event.</p>
    </div>
}
else
{
    <div class="card rd-card"><div class="table-responsive">
        <table class="table rd-table align-middle mb-0">
            <thead>
                <tr><th>Bib</th><th>Participant</th><th>Category</th><th>Status</th><th>Finish time</th><th>Position</th><th class="text-end">Save</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var formId = "result-" + row.Enrollment.EnrollmentId;
                    <tr>
                        <td><span class="count-pill">@row.Enrollment.BibNumber</span></td>
                        <td class="fw-semibold">@row.Enrollment.ParticipantName</td>
                        <td>@row.Enrollment.CategoryName</td>
                        <td><partial name="_Status" model="row.Enrollment.Status" /></td>
                        <td style="min-width:140px">
                            <input form="@formId" name="finishTime" class="form-control form-control-sm" placeholder="00:00:00" pattern="\d{1,2}:\d{2}:\d{2}" value="@(row.Result is null ? "" : UiHelpers.FormatTime(row.Result.FinishTime))" required />
                        </td>
                        <td style="min-width:100px">
                            <input form="@formId" name="finishPosition" type="number" min="1" class="form-control form-control-sm" value="@(row.Result?.FinishPosition)" required />
                        </td>
                        <td class="text-end text-nowrap">
                            <form id="@formId" asp-action="SaveResult" method="post" class="d-inline">
                                <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                <input type="hidden" name="enrollmentId" value="@row.Enrollment.EnrollmentId" />
                                @if (row.Result is not null)
                                {
                                    <input type="hidden" name="resultId" value="@row.Result.ResultId" />
                                }
                                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg"></i> Save</button>
                            </form>
                            @if (row.Result is not null)
                            {
                                <form asp-action="DeleteResult" method="post" class="d-inline" onsubmit="return confirm('Remove this result?');">
                                    <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                    <input type="hidden" name="resultId" value="@row.Result.ResultId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash-fill"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
}
