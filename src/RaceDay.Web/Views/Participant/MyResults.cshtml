@model List<ApiRaceResult>
@{
    ViewData["Title"] = "My results";
}
<div class="page-header">
    <h1 class="rd-heading">My results</h1>
    <p class="text-muted">Your personal race history across completed events.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-trophy"></i>
        <h2 class="h4 rd-heading">No results yet</h2>
        <p class="text-muted">Results appear here once an organiser has published them for an event you entered.</p>
    </div>
}
else
{
    <div class="card rd-card"><div class="table-responsive">
        <table class="table rd-table align-middle mb-0">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr>
            </thead>
            <tbody>
                @foreach (var result in Model)
                {
                    <tr>
                        <td class="fw-semibold">@result.EventName</td>
                        <td>@result.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@result.CategoryName</td>
                        <td><span class="finish-time">@UiHelpers.FormatTime(result.FinishTime)</span></td>
                        <td><span class="position-pill">@UiHelpers.Ordinal(result.FinishPosition)</span> <span class="text-muted small">out of @result.TotalFinishers finishers</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
}
