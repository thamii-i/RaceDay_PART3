@model ApiEvent
@{
    var banner = UiHelpers.MediaUrl(Model.BannerImage);
}
<div class="card rd-card event-card h-100">
    @if (banner is not null)
    {
        <img src="@banner" class="event-card-img" alt="Banner for @Model.EventName" />
    }
    else
    {
        <div class="event-card-img event-card-placeholder"><i class="bi @UiHelpers.TypeIcon(Model.EventType)"></i></div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="type-badge"><i class="bi @UiHelpers.TypeIcon(Model.EventType)"></i> @Model.EventType</span>
            <span class="text-muted small">@Model.DistanceKm.ToString("0.##") km</span>
        </div>
        <h3 class="card-title h5">@Model.EventName</h3>
        <p class="text-muted small mb-1"><i class="bi bi-calendar3"></i> @Model.EventDate.ToString("ddd, dd MMM yyyy")</p>
        <p class="text-muted small mb-3"><i class="bi bi-geo-alt-fill"></i> @Model.Location</p>
        <a class="btn btn-primary mt-auto" asp-controller="Participant" asp-action="EventDetails" asp-route-id="@Model.EventId">View event <i class="bi bi-arrow-right"></i></a>
    </div>
</div>
