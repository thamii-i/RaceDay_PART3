@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="text-center py-5">
    <div class="display-1 rd-heading text-accent">@Model.Code</div>
    <h1 class="rd-heading">@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house-fill"></i> Back to home</a>
</div>
