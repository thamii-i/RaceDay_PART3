@if (TempData["Success"] is string success && !string.IsNullOrEmpty(success))
{
    <div class="alert alert-success alert-dismissible fade show rd-alert" role="alert">
        <i class="bi bi-check-circle-fill"></i> @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] is string warning && !string.IsNullOrEmpty(warning))
{
    <div class="alert alert-warning alert-dismissible fade show rd-alert" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @warning
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string error && !string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show rd-alert" role="alert">
        <i class="bi bi-x-octagon-fill"></i> @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
